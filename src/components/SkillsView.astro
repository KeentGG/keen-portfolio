---
import BentoCard from "./BentoCard.astro";
import Chip from "./Chip.astro";

const frontendSkills = [
    "ReactJS",
    "TypeScript",
    "NextJS",
    "VueJS",
    "Angular",
    "TailwindCSS",
    "Flutter",
    "HTML5/CSS",
    "JavaScript",
    "WordPress",
    "Shopify Liquid",
    "Design Systems",
    "Component Libraries",
    "Responsive Design",
];

const backendSkills = [
    "Node.js",
    "ExpressJS",
    "NestJS",
    "AdonisJS",
    "Laravel",
    "REST API",
    "GraphQL",
    "PostgreSQL",
    "MySQL",
    "MongoDB",
    "Firebase",
    "Vector DBs (Qdrant)",
];

const aiAndTools = [
    "OpenAI",
    "RAG Pipelines",
    "AI Chatbots",
    "AI Agentic Coding",
    "Spec-Driven Dev",
    "Vercel AI SDK",
    "Python",
    "Docker",
    "Figma",
    "UI/UX Design",
    "Git",
    "Vercel",
];
---

<div
    class="z-20 mt-4 flex flex-row justify-center items-start gap-4 flex-wrap -mb-4 px-4 *:min-w-[20rem] *:flex-[3] perspective"
>
    <div class="z-10 lg:rotate-left h-full lg:h-full">
        <BentoCard heading="Backend" class="h-full">
            <div class="flex flex-row flex-wrap gap-2">
                {backendSkills.map((skill, _i) => <Chip label={skill} />)}
            </div>
        </BentoCard>
    </div>
    <div class="z-20">
        <BentoCard heading="Frontend" class="h-auto lg:h-full">
            <div class="flex flex-row flex-wrap gap-2">
                {frontendSkills.map((skill, _i) => <Chip label={skill} />)}
            </div>
        </BentoCard>
    </div>
    <div class="z-10 lg:rotate-right">
        <BentoCard heading="AI & Tools" class="h-full">
            <div class="flex flex-row flex-wrap gap-2">
                {aiAndTools.map((skill, _i) => <Chip label={skill} />)}
            </div>
        </BentoCard>
    </div>
</div>
