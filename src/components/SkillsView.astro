---
import BentoCard from "./BentoCard.astro";
import Chip from "./Chip.astro";
import SectionHeading from "./SectionHeading.astro";
import { capabilityStack } from "../data/portfolio";
import StackIcon from "./icons/StackIcon.astro";
import MonitorIcon from "./icons/MonitorIcon.astro";
import GlobeIcon from "./icons/GlobeIcon.astro";
import ActivityIcon from "./icons/ActivityIcon.astro";

interface Props {
    hideHeading?: boolean
}

const { hideHeading = false } = Astro.props

const stackIcons = [MonitorIcon, StackIcon, GlobeIcon, ActivityIcon]
const stackColors = [
    'text-sky-400 bg-sky-400/10 border-sky-400/20',
    'text-violet-400 bg-violet-400/10 border-violet-400/20',
    'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
    'text-amber-400 bg-amber-400/10 border-amber-400/20',
]
---

{!hideHeading && (
    <SectionHeading title="My Stack" class="px-4">
        <StackIcon slot="icon" class="size-4.5" />
    </SectionHeading>
)}
<div
    class="z-20 mt-4 flex flex-row justify-center items-start gap-4 flex-wrap mb-8 px-4 *:min-w-[20rem] *:flex-[3] perspective"
>
    {capabilityStack.map((group, i) => {
        const Icon = stackIcons[i]
        const colorClass = stackColors[i]
        return (
            <div
                class:list={[
                    i === 0 && "z-10 lg:rotate-left h-full lg:h-full",
                    i === capabilityStack.length - 1 && "z-10 lg:rotate-right",
                    i > 0 && i < capabilityStack.length - 1 && "z-20",
                ]}
            >
                <BentoCard heading={group.title} class={i === 1 ? "h-auto lg:h-full" : "h-full"}>
                    <div class="flex items-center gap-2 mb-3">
                        <div class:list={['flex items-center justify-center size-7 rounded-md border shrink-0', colorClass]}>
                            <Icon class="size-3.5" />
                        </div>
                    </div>
                    <div class="flex flex-row flex-wrap gap-2">
                        {group.skills.map((skill) => <Chip label={skill} />)}
                    </div>
                    <p class="text-cloud-500 text-sm mt-3 leading-relaxed">{group.evidence}</p>
                </BentoCard>
            </div>
        )
    })}
</div>
