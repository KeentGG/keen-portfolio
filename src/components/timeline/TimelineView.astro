---
import TimelineRow from "./TimelineRow.astro";
import BabyIcon from "../../components/icons/BabyIcon.astro";
import AcademicIcon from "../../components/icons/AcademicIcon.astro";
import WorkIcon from "../../components/icons/WorkIcon.astro";
import GridCard from "../../components/GridCard.astro";
import SocialButton from "../../components/SocialButton.astro";
import LinkedInIcon from "../../components/icons/LinkedInIcon.astro";
import GithubIcon from "../../components/icons/GithubIcon.astro";
import BentoCard from "../../components/BentoCard.astro";
---

<div
    class="z-20 flex flex-row justify-center gap-4 flex-wrap
  w-full -mt-4 px-4 pb-4 max-w-[72rem]"
>
    <div class="w-full lg:max-w-[80vw] flex-[5] min-w-[20rem] md:min-w-[26rem]">
        <BentoCard heading="Career" class="h-fit">
            <div
                class="text-pretty flex flex-col *:flex
                                *:flex-row *:gap-2"
            >
                <TimelineRow
                    heading="Stratium Software Group"
                    subHeading="Intern & Part-time Software Engineer"
                    date="2018 (9 mos.)"
                    skills={[
                        {
                            name: "Shopify Liquid",
                            color: "#96BF49",
                        },
                        {
                            name: "iOS/Objective-C",
                            color: "#1B9EF8",
                        },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Started as an intern building a custom Shopify frontend
                        using Liquid templating engine. <br /><br /> After
                        internship, absorbed into a part-time software engineer
                        role maintaining EloTouch's Objective-C iPad
                        applications. EloTouch is the inventor of resistive
                        touchscreen displays, delivering touch solutions used by
                        millions of POS devices worldwide.
                    </div>
                </TimelineRow>
                <TimelineRow
                    heading="Stratium Software Group"
                    subHeading="Software Engineer"
                    date="2019 - 2021 (2 yrs.)"
                    skills={[
                        {
                            name: "Flutter",
                            color: "#5FCAF8",
                        },
                        {
                            name: "iOS/Objective-C",
                            color: "#1B9EF8",
                        },
                        {
                            name: "Firebase",
                            color: "#F8A71A",
                        },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Returned full-time after graduating with a BS in
                        Computer Engineering. Led development of a Flutter LMS
                        mobile app serving 1,000+ students and parents, fully
                        digitizing school transactions. <br /><br /> Built a
                        reusable Flutter component library with 30+ UI
                        components. Continued maintaining EloTouch's Objective-C
                        iOS SDK used by millions of POS devices for payment
                        processing.
                    </div>
                </TimelineRow>
                <TimelineRow
                    heading="Suzerin Pte Ltd"
                    subHeading="Frontend VueJS Developer"
                    date="2021 - 2022 (1 yr.)"
                    skills={[
                        { name: "VueJS", color: "#55C895" },
                        {
                            name: "TailwindCSS",
                            color: "#38BDF8",
                        },
                        {
                            name: "Laravel",
                            color: "#F82A12",
                        },
                        { name: "Xero/QuickBooks", color: "#2DB84B" },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Developed a Vue.js financial accounting app using
                        TailwindCSS and Laravel, integrating with Xero and
                        QuickBooks for portfolio insights. <br /><br />
                        Engineered a spreadsheet-like financial table with
                        dynamic calculation logic. Enhanced a Vue.js LMS with
                        grading, enrollment, and quiz assignment features.
                    </div>
                </TimelineRow>
                <TimelineRow
                    heading="Tau Express"
                    subHeading="Frontend ReactJS Developer"
                    date="2022 - 2024 (1.5 yrs.)"
                    skills={[
                        { name: "ReactJS", color: "#00d8ff" },
                        { name: "TypeScript", color: "#3178C6" },
                        { name: "Python", color: "#FBD84C" },
                        {
                            name: "TailwindCSS",
                            color: "#38BDF8",
                        },
                        { name: "Storybook", color: "#F64D89" },
                        { name: "WordPress", color: "#64C3ED" },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Built and optimized 3 WordPress marketing sites using
                        SEO analytics. Led development of an accessible React
                        component library with 20+ reusable components, powering
                        migrations of 5+ legacy React apps from v12 to v17.
                        <br /><br /> Created and maintained 30+ Python crawlers
                        for news and political sites, building a scalable data
                        collection infrastructure that powered AI/ML training
                        data pipelines. Built a backend monitoring system to
                        oversee crawler health and data quality.
                    </div>
                </TimelineRow>
                <TimelineRow
                    heading="UK Clients & BlackAcre Solutions"
                    subHeading="Contract Frontend Developer"
                    date="2024 (4 mos.)"
                    skills={[
                        { name: "ReactJS", color: "#00d8ff" },
                        { name: "NextJS", color: "#FFFFFF" },
                        { name: "Figma", color: "#F67569" },
                        { name: "Flutter", color: "#5FCAF8" },
                        {
                            name: "Firebase",
                            color: "#F8A71A",
                        },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Built real estate marketing sites with modern web
                        frameworks and aided a legal-related system web app.
                        Developed a high-impact Next.js landing page with
                        animations for premium software services. <br /><br />
                        Prototyped a Flutter Country Tracker app on
                        Firebase/Firestore and a Vercel AI chatbot,
                        demonstrating real-time data and advanced AI
                        interactions.
                    </div>
                </TimelineRow>
                <TimelineRow
                    heading="Valhalla Inc."
                    subHeading="Sr. Frontend Developer w/ UI/UX Experience"
                    date="2024 - Present"
                    skills={[
                        { name: "ReactJS", color: "#00d8ff" },
                        { name: "TypeScript", color: "#3178C6" },
                        { name: "OpenAI/RAG", color: "#10A37F" },
                        {
                            name: "Qdrant",
                            color: "#DC3FFF",
                        },
                        {
                            name: "ExpressJS",
                            color: "#FFFFFF" },
                        {
                            name: "Figma",
                            color: "#F67569",
                        },
                        {
                            name: "Git",
                            color: "#F1573B",
                        },
                    ]}
                >
                    <div class="my-2 text-cloud-200">
                        Senior frontend developer for a world-renowned high-tech
                        gym client. Architected and shipped an internal AI
                        chatbot with RAG pipelines (OpenAI, Gemini embeddings,
                        Qdrant), Express.js APIs, and a custom UI with threaded
                        conversations and auto-summaries. <br /><br />
                        Migrated 10+ legacy jQuery pages to React, cutting load
                        times from ~4s to ~1s. Designed and shipped a modern
                        visual theme for legacy dashboard pages. Led the
                        company's first AI coding skill-sharing session to
                        upskill the engineering team.
                    </div>
                </TimelineRow>
            </div>
        </BentoCard>
    </div>
    <div
        class="gap-4 flex flex-col flex-[4] min-w-[20rem] md:min-w-[22rem]
                        lg:max-w-[80vw] w-full h-min"
    >
        <BentoCard heading="While AFK i do" class="h-full w-full pb-2">
            <div class="relative flex flex-col justify-center">
                <span
                    class="absolute top-0 left-0 bottom-0 right-0 border
                                    border-cloud-900"
                ></span>
                <div class="flex flex-wrap w-full *:w-max">
                    <GridCard class="flex-1">
                        <div>Hiking</div>
                    </GridCard>
                    <GridCard class="flex-[2]">
                        <div>Mobile Games</div>
                    </GridCard>
                    <GridCard class="flex-1">
                        <div>Roadtrip</div>
                    </GridCard>
                </div>
                <div class="flex flex-wrap *:w-max *:flex-1">
                    <GridCard>
                        <div>Read tech stuffs</div>
                    </GridCard>
                    <GridCard>
                        <div>Watch space stuffs</div>
                    </GridCard>
                </div>
                <div class="flex flex-wrap *:w-max *:flex-1">
                    <GridCard>
                        <div>Walking</div>
                    </GridCard>
                    <GridCard>
                        <div>Explore Cafes</div>
                    </GridCard>
                    <GridCard>
                        <div>Food</div>
                    </GridCard>
                </div>
            </div>
        </BentoCard>
        <BentoCard heading="About Me" class="w-full">
            <div class="text-cloud-300">
                <div
                    class="text-pretty max-w-[36em] flex flex-col *:flex *:flex-row *:gap-2"
                >
                    <TimelineRow heading="Young age">
                        <BabyIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Started learning basic and plain websites.
                        </div>
                    </TimelineRow>
                    <TimelineRow heading="Highschool" date="2013">
                        <AcademicIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Championed a regional Web Page Design competition,
                            designing and developing a city tourism web page
                            within a day.
                        </div>
                    </TimelineRow>
                    <TimelineRow heading="College">
                        <AcademicIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Attended Google Developer Group (GDG) seminars,
                            Mozilla Wearable seminar, and tech industry events.
                            Interned at Stratium Software Group while completing
                            studies.
                        </div>
                    </TimelineRow>
                    <TimelineRow heading="Undergraduate" date="2019">
                        <AcademicIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Graduated with a Bachelor of Science in Computer
                            Engineering (Hardware and Software) from University
                            of St. La Salle.
                        </div>
                    </TimelineRow>
                    <TimelineRow heading="Career">
                        <WorkIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Absorbed by Stratium after internship, then worked
                            across 4 more companies — all remote since 2021.
                            Built component libraries in React and Flutter,
                            financial accounting systems, and AI/ML data
                            pipelines with 30+ Python crawlers.
                        </div>
                    </TimelineRow>
                    <TimelineRow heading="AI & Agentic Development">
                        <WorkIcon slot="icon" class="size-5" />
                        <div class="my-2 text-cloud-200">
                            Architected an end-to-end AI chatbot with RAG
                            pipelines at Valhalla. Building a self-tuning spec
                            agent framework that explores codebases and generates
                            comprehensive specs. Led the company's first AI
                            agentic coding skill-sharing session.
                        </div>
                    </TimelineRow>
                </div>
            </div>
        </BentoCard>
        <BentoCard heading="Let's work together">
            <div class="flex flex-col gap-4">
                <div class="flex flex-row w-full text-sm gap-4">
                    <div class="flex flex-col w-full">
                        <div class="text-cloud-400 font-medium">Phone</div>
                        <div class="text-cloud-300 text-base font-light">
                            +63 928 906 5696
                        </div>
                    </div>
                    <div class="flex flex-col w-full">
                        <div class="text-cloud-400 font-medium">
                            Email Address
                        </div>
                        <div class="text-cloud-300 text-base font-light">
                            keanukent.dev@gmail.com
                        </div>
                    </div>
                </div>
                <div class="flex flex-row gap-2">
                    <SocialButton label="LinkedIn" color="#2E6CB5">
                        <LinkedInIcon
                            slot="icon"
                            class="size-6 text-[#2E6CB5]"
                            href="https://www.linkedin.com/in/keanukentgargar/"
                            target="_blank"
                        />
                    </SocialButton>
                    <SocialButton label="Github" color="#A54CB1">
                        <GithubIcon
                            slot="icon"
                            class="size-6 text-[#A54CB1]"
                            href="https://github.com/KeentGG"
                            target="_blank"
                        />
                    </SocialButton>
                </div>
            </div>
        </BentoCard>
    </div>
</div>
