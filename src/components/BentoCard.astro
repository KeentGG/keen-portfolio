---
import { cn } from '../utils/utils.ts'

const { heading, class: className } = Astro.props
---

<div
    class={cn(
        'dark-smooth-shadow-lg bg-cloud-900 rounded-[14px] p-5 border border-cloud-700/40',
        'hover:border-cloud-600/50 transition-all duration-300',
        'group',
        className
    )}
>
    <h3 class="text-cloud-200 font-semibold text-lg mb-4 tracking-tight">{heading}</h3>
    <div>
        <slot />
    </div>
</div>
